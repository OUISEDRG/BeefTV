{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bridgeJobId", "intentId", "upstreamTaskId", "source", "reference", "outcome"],
  "properties": {
    "schemaVersion": {"const": 1},
    "bridgeJobId": {"type": "string", "minLength": 1, "maxLength": 200},
    "intentId": {"type": "string", "minLength": 1, "maxLength": 256},
    "upstreamTaskId": {"type": ["integer", "string", "null"], "minimum": 1, "minLength": 1, "maxLength": 200},
    "source": {"const": "official_statement"},
    "reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "outcome": {"enum": ["charge_confirmed", "rejected_without_charge"]},
    "actualPoints": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "accepted": {"const": false},
    "charged": {"const": false}
  },
  "if": {"properties": {"outcome": {"const": "charge_confirmed"}}},
  "then": {
    "required": ["actualPoints"],
    "properties": {"upstreamTaskId": {"type": ["integer", "string"]}},
    "not": {"anyOf": [{"required": ["accepted"]}, {"required": ["charged"]}]}
  },
  "else": {
    "required": ["accepted", "charged"],
    "properties": {"upstreamTaskId": {"const": null}},
    "not": {"required": ["actualPoints"]}
  }
}
