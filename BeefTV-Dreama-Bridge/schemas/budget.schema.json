{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "enabled", "dailyLimitPoints", "perOperationLimits", "timezone", "dayStart"],
  "$defs": {"points": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}, {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}]}},
  "properties": {"schemaVersion": {"const": 1}, "enabled": {"type": "boolean"},
    "mode": {"enum": ["budgeted", "direct-authorized"]},
    "dailyLimitPoints": {"$ref": "#/$defs/points"},
    "timezone": {"type": ["string", "null"], "minLength": 1},
    "dayStart": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "perOperationLimits": {"type": "object", "additionalProperties": false,
      "required": ["video", "image", "extension", "enhancement", "audio"],
      "properties": {"video": {"$ref": "#/$defs/points"}, "image": {"$ref": "#/$defs/points"}, "extension": {"$ref": "#/$defs/points"}, "enhancement": {"$ref": "#/$defs/points"}, "audio": {"$ref": "#/$defs/points"}}}}
}
